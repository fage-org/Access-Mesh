# 平台本地运行端口号
VITE_PORT = 8848

# 开发环境读取配置文件路径
VITE_PUBLIC_PATH = /

# 开发环境路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 开发代理目标（Gateway 主端口；/auth、/admin、/perm、/example 四条前缀同路径转发，无 rewrite）
VITE_PROXY_TARGET = "http://localhost:8080"

# mock 登录开关（T-FE-041）：false=真实 /auth 链路经 Gateway；true=仅前端联调用 mock 登录
# （mock/login.ts 按 process.env.VITE_MOCK_LOGIN 条件注册，true 时响应壳已对齐 PermResult 契约）
VITE_MOCK_LOGIN = false
