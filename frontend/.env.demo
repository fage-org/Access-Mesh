# 演示构建：显式启用生产 mock（fake-server）供静态演示
# 真实部署构建用 .env.production / .env.staging（VITE_ENABLE_PROD_MOCK=false）
# V2 transport 同步消费此开关（见 transport/index.ts）：true 时 V2 用内存 transport
VITE_ENABLE_PROD_MOCK = true

# 演示构建打包路径
VITE_PUBLIC_PATH = /

# 演示构建路由历史模式（Hash模式传"hash"、HTML5模式传"h5"）
VITE_ROUTER_HISTORY = "hash"

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN = false

# 是否启用gzip压缩或brotli压缩
VITE_COMPRESSION = "none"
