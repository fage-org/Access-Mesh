# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# 公开构建默认值，保证干净检出可直接构建生产前端；此文件不得放密钥。
# 特定环境可覆盖，个人部署差异使用被忽略的 .env.*.local。
VITE_PUBLIC_PATH = /
VITE_ROUTER_HISTORY = "hash"
VITE_CDN = false
VITE_COMPRESSION = "none"
VITE_ENABLE_PROD_MOCK = false
