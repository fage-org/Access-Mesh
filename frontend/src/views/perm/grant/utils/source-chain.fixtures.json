{
  "version": 1,
  "description": "来源链 Golden Fixture（6 用例精简，第十四轮）：全局回退/组合位/ALL/资源继承/操作继承/两段组合来源。前端 source-chain.ts 与后端 GoldenFixtureTest（T-PERM-034）同用例集比对——本文件为权威用例源，后端落地时移植对齐（docs/design/frontend/permission-grant.md §12 工程加固方案三）。位值均为十进制字符串（T-PERM-028 线格式）。",
  "semantics": {
    "coveredSet": "coveredSet = ⋃_{bit ∈ 定义位(grantedBits)} (bit.binaryBit | bit.inheritMask)",
    "covers": "(effectiveBits(A) & B.binaryBit) != 0，effectiveBits = binaryBit | inheritMask",
    "nodeClosure": "descendants(r) ∪ {r}（collectDescendants 不含源节点，显式并入）",
    "mergeRule": "专属优先、全局回退：同 code 存在专属定义用专属，否则用全局"
  },
