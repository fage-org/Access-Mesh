<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.permission.mapper.PcResourceDependencyMapper">

    <resultMap id="ResourceDependencyResultMap" type="org.dromara.permission.domain.PcResourceDependency">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="resource_entity_id" property="resourceEntityId"/>
        <result column="depends_on_resource_entity_id" property="dependsOnResourceEntityId"/>
        <result column="source_operation_permission_id" property="sourceOperationPermissionId"/>
        <result column="required_operation_permission_id" property="requiredOperationPermissionId"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_by" property="deletedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="delete_flag" property="deleteFlag"/>
    </resultMap>

    <select id="selectByTenantAndResourceEntityId" resultMap="ResourceDependencyResultMap">
        SELECT id, tenant_id, resource_entity_id, depends_on_resource_entity_id, source_operation_permission_id,
               required_operation_permission_id, created_by, updated_by, deleted_by,
               created_at, updated_at, deleted_at, delete_flag
        FROM resource_dependency
        WHERE tenant_id = #{tenantId}
          AND resource_entity_id = #{resourceEntityId}
          AND delete_flag = 0
        ORDER BY id ASC
    </select>
</mapper>
