<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.permission.mapper.PcPermissionConflictRuleMapper">

    <resultMap id="PermissionConflictRuleResultMap" type="org.dromara.permission.domain.PcPermissionConflictRule">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="biz_domain_id" property="bizDomainId"/>
        <result column="first_operation_permission_id" property="firstOperationPermissionId"/>
        <result column="second_operation_permission_id" property="secondOperationPermissionId"/>
        <result column="resource_type_value" property="resourceTypeValue"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_by" property="deletedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="delete_flag" property="deleteFlag"/>
    </resultMap>

    <select id="selectByTenantAndResourceType" resultMap="PermissionConflictRuleResultMap">
        SELECT id, tenant_id, biz_domain_id, first_operation_permission_id, second_operation_permission_id,
               resource_type_value, created_by, updated_by, deleted_by,
               created_at, updated_at, deleted_at, delete_flag
        FROM permission_conflict_rule
        WHERE tenant_id = #{tenantId}
          AND delete_flag = 0
          AND (resource_type_value IS NULL OR resource_type_value = #{resourceTypeValue})
        ORDER BY biz_domain_id NULLS FIRST, id ASC
    </select>
</mapper>
