<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.dromara.permission.mapper.PcUserRoleMapper">

    <resultMap id="UserRoleResultMap" type="org.dromara.permission.domain.PcUserRole">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="abstract_user_id" property="abstractUserId"/>
        <result column="abstract_role_id" property="abstractRoleId"/>
        <result column="valid_from" property="validFrom"/>
        <result column="valid_to" property="validTo"/>
        <result column="created_by" property="createdBy"/>
        <result column="updated_by" property="updatedBy"/>
        <result column="deleted_by" property="deletedBy"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted_at" property="deletedAt"/>
        <result column="delete_flag" property="deleteFlag"/>
    </resultMap>

    <select id="selectEffectiveByTenantAndUser" resultMap="UserRoleResultMap">
        SELECT id, tenant_id, abstract_user_id, abstract_role_id, valid_from, valid_to,
               created_by, updated_by, deleted_by, created_at, updated_at, deleted_at, delete_flag
        FROM user_role
        WHERE tenant_id = #{tenantId}
          AND abstract_user_id = #{abstractUserId}
          AND delete_flag = 0
          AND (valid_from IS NULL OR valid_from &lt;= #{now})
          AND (valid_to IS NULL OR valid_to &gt;= #{now})
        ORDER BY id ASC
    </select>
</mapper>
