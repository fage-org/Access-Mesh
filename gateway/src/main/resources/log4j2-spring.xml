<?xml version="1.0" encoding="UTF-8"?>
<!-- T-ACCESS-003 第四轮评审 P2 修复（2026-08-14）：
     1) Property 必须位于 Properties 容器内——原配置直接放根节点导致 Log4j2 报
        "Unknown object Property"，${LOG_PATTERN} 输出为字面量、真实日志内容丢失；
     2) 布局改为 JsonLayout（project-rules §4.2「所有环境统一输出 JSON 格式」）：
        properties=true 输出 MDC 上下文（traceId/userId/tenantId/serviceCode 由
        应用侧注入），includeStacktrace=true 保留异常堆栈，eventEol 每条一行便于采集。 -->
<configuration scan="true" scanPeriod="60 seconds">
    <include resource="org/springframework/boot/logging/log4j2/log4j2-file.xml"/>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <JsonLayout compact="true" complete="false" properties="true"
                        includeStacktrace="true" eventEol="true"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</configuration>
