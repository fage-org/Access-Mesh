<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ac.fage.accessmesh</groupId>
        <artifactId>accessmesh</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>gateway</artifactId>
    <name>Gateway Service</name>
    <description>Spring Cloud Gateway - traffic entry point</description>

    <dependencies>
        <!-- 不再依赖空壳 SDK 的传递顺序；直接固定默认 starter 的日志排除。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
            <exclusions>
                <exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>common</artifactId>
            <!-- T-ACCESS-100：common 的 spring-boot-starter-web 已改 optional，不再传递
                 spring-webmvc/Tomcat——原 T-ACCESS-003（2026-08-14）的 webmvc 排除与
                 MvcFoundOnClasspathException 防线随之退役（防线本体：common 边不传 Web 栈）。
                 WebMvc 系组件（GlobalExceptionHandler/RResponseAdvice）的装配注册同样
                 不在 common（见本服务 imports 文件，Gateway 维持不装配）。 -->
        </dependency>
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>perm-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-reactor-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
        </dependency>
        <!-- sa-token-jackson 的 optional Java Time 支持必须由运行宿主提供；Boot 4 Jackson 3 不替代它。 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- T-GW-004：监控指标 + Prometheus 端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <!-- T-PERM-017 C4：补测试依赖（仅 test scope）；现用于 InterfaceAdmissionMatcher/PermissionFilter 等网关单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T-ACCESS-031：E2E 两个 IT 连同其跨服务 test 依赖（access-service /
             example-service / spring-webmvc）与容器轨基建（testcontainers 依赖、
             双 execution、-DskipTestcontainers 开关、api.version 钉版——容器轨唯一
             消费者即两个 E2E，迁移后 gateway/src 零 testcontainers 引用）整体迁入独立
             e2e 模块——gateway 解除 test-scope 模块依赖后恢复轻模块，可与 access-service
             在 mvn -T 下并行；子进程类路径配方见 e2e/pom.xml（原样迁入）。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- T-ACCESS-031：容器轨随 E2E 迁入 e2e 模块后 gateway 仅剩单 execution
                 （单元/上下文测试）；surefire 通用配置沿用（nacos 日志关闭防测试在
                 构建目录外写日志文件、*IT.java includes、空匹配容忍）。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <nacos.logging.default.config.enabled>false</nacos.logging.default.config.enabled>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
