<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ac.fage.accessmesh</groupId>
        <artifactId>accessmesh</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>gateway</artifactId>
    <name>Gateway Service</name>
    <description>Spring Cloud Gateway - traffic entry point</description>

    <properties>
        <!-- 单测轨道开关（T-ACCESS-021 与 access-service 同款双 execution 分层）：
             true 时 mvn test 跳过 testcontainers 组 execution（CI 单测 job / 本地快速反馈） -->
        <skipTestcontainers>false</skipTestcontainers>
    </properties>

    <dependencies>
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>common</artifactId>
            <!-- T-ACCESS-003 评审 P1 修复（2026-08-14）：排除 spring-webmvc 传递依赖。
                 common 的 GlobalExceptionHandler/RResponseAdvice 是 WebMvc 组件
                 （GatewayApplication 已 exclude CommonAutoConfiguration 不加载），
                 spring-webmvc 在 classpath 触发 Spring Cloud Gateway 的
                 MvcFoundOnClasspathException（Gateway 不允许 MVC/WebFlux 共存），
                 且默认 Bean 名 gatewayProperties 冲突（已改名 accessGatewayProperties）。 -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework</groupId>
                    <artifactId>spring-webmvc</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>perm-gateway-spring-boot-starter</artifactId>
            <!-- T-ACCESS-003 第三轮评审 P2 修复（2026-08-14）：排除 spring-boot-starter-logging 传递依赖。
                 经 perm-gateway-spring-boot-starter → spring-boot-starter 引入 Logback，与显式
                 spring-boot-starter-log4j2 并存时 SLF4J 双 Provider，实际选择 Logback 导致
                 log4j2-spring.xml（JSON 日志/滚动策略/级别配置）全部被忽略（违反项目日志规范）。
                 与 access-service 对 perm-client-spring-boot-starter 的处理同模式。 -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-reactor-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- T-GW-004：监控指标 + Prometheus 端点 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <!-- T-PERM-017 C4：补测试依赖（仅 test scope），用于 InterfaceSnapshotMatcher 单元测试 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T-ACCESS-021：Testcontainers 容器轨道（PG/Redis） -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T-ACCESS-021：common（compile）对 spring-webmvc 的既有排除使最近路径的
             starter-web 子树失去 webmvc，access-service(test) 的同 artifact 路径整体被
             「omitted for duplicate」去重——webmvc 因此从测试类路径消失，E2E 的
             access-service 子进程（servlet 栈）无法启动。显式 test 依赖恢复：仅进入
             测试类路径（GatewayApplicationConfigTest 已显式 reactive），生产编译/运行
             classpath 不受影响。 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webmvc</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- T-ACCESS-021：跨服务 E2E IT（BasicRoleGrantVerticalSliceE2EIT）以子进程启动
             access-service——两服务需在同一 java.class.path 上。仅 test scope，不进入生
             产依赖图。排除 spring-boot-starter-logging 防 Logback 与 log4j2 双 Provider
             （与 access-service 对 web starter 的处理同模式；其依赖树实测无 logback，此为
             防回归保险）。注意：webmvc/webflux 因此共存于 gateway 测试类路径——上下文测试
             显式 reactive（GatewayApplicationConfigTest），E2E 子进程按服务各自显式声明。 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>access-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- T-API-001：跨服务 E2E IT（ExampleProtectedApiE2EIT）以子进程启动
             example-service（网关 /example/** 路由的下游）——三服务需在同一
             java.class.path 上。仅 test scope，不进入生产依赖图；排除
             spring-boot-starter-logging 防 Logback 与 log4j2 双 Provider。 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>example-service</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- T-ACCESS-021：与 access-service 同款双 execution 分层（默认 execution 排除
                 testcontainers 组、容器组独立 execution 可经 -DskipTestcontainers=true 跳过），
                 CI 单测 job 全量跑容器 E2E 会拖垮反馈速度，必须与仓库既有轨道一致分层。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <nacos.logging.default.config.enabled>false</nacos.logging.default.config.enabled>
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <excludedGroups>testcontainers</excludedGroups>
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
                <executions>
                    <execution>
                        <id>testcontainers</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludedGroups combine.self="override"/>
                            <groups>testcontainers</groups>
                            <skip>${skipTestcontainers}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
