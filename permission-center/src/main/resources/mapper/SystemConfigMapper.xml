<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ac.fage.accessmesh.permission.mapper.SystemConfigMapper">

    <select id="selectByConfigKey" resultType="cn.ac.fage.accessmesh.permission.entity.SystemConfig">
        SELECT * FROM system_config
        WHERE tenant_id = #{tenantId}
          AND config_key = #{configKey}
          AND delete_flag = 0
    </select>

    <select id="selectByTenantId" resultType="cn.ac.fage.accessmesh.permission.entity.SystemConfig">
        SELECT * FROM system_config
        WHERE tenant_id = #{tenantId}
          AND delete_flag = 0
    </select>

    <select id="selectByConfigKeys" resultType="cn.ac.fage.accessmesh.permission.entity.SystemConfig">
        SELECT * FROM system_config
        WHERE tenant_id = #{tenantId}
          AND delete_flag = 0
          AND config_key IN
        <foreach collection="configKeys" item="key" open="(" separator="," close=")">
            #{key}
        </foreach>
    </select>

</mapper>
