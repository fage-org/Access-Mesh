# AccessMesh 部署密钥模板（T-ACCESS-047）
# 用法：复制为 .env 并填值——docker compose --profile app 自动读取仓库根目录 .env。
#   cp .env.example .env
# 两档均须填写数据库和 Redis 密码；缺失或空值时 Compose 拒绝启动。

# ============ 必填（仅基建与全栈均适用）============
DB_PASSWORD=
REDIS_PASSWORD=

# ============ 必填（全栈 --profile app）============

# 首管理员密码：bootstrap 空库首启创建 admin 账号（幂等——存量库重复启动 no-op，绝不重置密码）
ACCESS_BOOTSTRAP_ADMIN_PASSWORD=

# JWT 签名密钥：≥32 字符，缺失或过短 access-service 启动失败
JWT_SECRET_KEY=

# 用户身份头 HMAC-SHA256 签名密钥：Gateway 签发、access-service/example-service 校验——
# 三处必须同值（不一致时经 Gateway 的 example 请求一律信封 30003）
ACCESSMESH_SIGNATURE_SECRET=

# 服务间内部密钥：Gateway → access-service 的 X-Internal-Secret——与 access-service 同值
PERM_INTERNAL_SECRET=

# 示例业务服务：每个接入租户注册 example-service 并签发自己的凭证。
# 填写 JSON（或通过 Nacos 配置同名属性），secret 仅来自签发响应；不要把真实值提交仓库。
# JSON 结构示例（用真实签发值替换占位符，可继续添加租户键）：
# {"example":{"permission":{"allow-insecure":true,"tenant-credentials":{"1":{"credential-id":"<id>","credential-secret":"<secret>"}}}}}
# true=单信任域；跨边界填 false 并部署 TLS。缺租户映射时拒绝最终检查，不回落固定凭证。
EXAMPLE_PERMISSION_CONFIG_JSON=

# ============ 可选（默认与 compose 基建一致）============

# 数据库账号（初始化 PostgreSQL 与 app 档同源）
#DB_USERNAME=postgres

# 容器使用内置 Nacos；接外部 Nacos 时修改地址，三服务统一消费。
# 本机直接运行 Java 服务时使用 127.0.0.1:8848，并显式导出数据库/Redis 密码。
#NACOS_SERVER_ADDR=nacos:8848

# Gateway CORS 允许 origin：全栈档前端经 nginx 同源反代（明文 http + 默认端口形态）不触发 CORS，可置空禁用；
# 生产 TLS 终结/对外非默认端口形态同源短路不成立、不得置空——须列入对外 Origin（如 https://your-domain），见 docs/ops/deployment.md §1
#GATEWAY_CORS_ALLOWED_ORIGINS=

# 前端镜像构建 npm 源（默认国内镜像，海外构建可改 https://registry.npmjs.org）
#NPM_REGISTRY=https://registry.npmmirror.com
