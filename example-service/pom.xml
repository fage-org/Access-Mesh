<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ac.fage.accessmesh</groupId>
        <artifactId>accessmesh</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>example-service</artifactId>
    <name>Example Service</name>
    <description>Demo service showing permission center integration</description>

    <dependencies>
        <!-- 统一响应体 R / 全局异常处理 / UTC 时区装配；缓存等能力按条件装配，无 Redis 也可启动 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <!-- 接口级鉴权仍由 Gateway 承担；registration 仅用于显式开启的独立声明发布。 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>perm-registration-spring-boot-starter</artifactId>
        </dependency>
        <!-- 业务最终检查客户端（T-ACCESS-061 用户拍板 2026-09-28：SDK starter 形态）：
             经 PermissionFeignClient 调 auth/check 族端点（§8.6 逐路由最终检查）；
             服务认证=per-service 凭证——共享实例按网关验签租户从
             example.permission.tenant-credentials 选凭证，经 SDK 显式头重载随请求发送
             （T-ACCESS-081 方案 B；旧密钥通道与租户发头拦截器已随 T-ACCESS-079/080 退役）。 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>perm-client-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 排除 Logback（与显式 spring-boot-starter-log4j2 并存时 SLF4J 双 Provider，
                 实际选择 Logback 导致 log4j2-spring.xml 全部被忽略——与 access-service/gateway
                 对 starter 的处理同模式） -->
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
