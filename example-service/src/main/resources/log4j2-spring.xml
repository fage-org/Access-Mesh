<?xml version="1.0" encoding="UTF-8"?>
<!-- 布局与 access-service/Gateway 同口径：JsonLayout（project-rules §4.2「所有环境统一输出
     JSON 格式」），properties=true 输出 MDC 上下文，includeStacktrace=true 保留异常堆栈，
     eventEol 每条一行便于 ELK/Loki 采集。 -->
<configuration scan="true" scanPeriod="60 seconds">
    <include resource="org/springframework/boot/logging/log4j2/log4j2-file.xml"/>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <JsonLayout compact="true" complete="false" properties="true"
                        includeStacktrace="true" eventEol="true"/>
        </Console>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</configuration>
