<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ac.fage.accessmesh.access.permission.mapper.PermissionChangeLogMapper">

    <!-- T-PERM-032：页面查询与 recent-changes 统一条件组（对齐 schema 索引：user/role GIN 包含、
         eventType 表达式索引、时间/实体普通索引；changeSource 低基数无索引） -->
    <sql id="listCondition">
        WHERE tenant_id = #{tenantId}
        <if test="entityType != null">
            AND entity_type = #{entityType}
        </if>
        <if test="entityId != null">
            AND entity_id = #{entityId}
        </if>
        <if test="userId != null">
            AND affected_abstract_user_ids @> ARRAY[#{userId}]::bigint[]
        </if>
        <if test="roleId != null">
            AND affected_abstract_role_ids @> ARRAY[#{roleId}]::bigint[]
        </if>
        <if test="since != null">
            AND created_at &gt;= #{since}
        </if>
        <if test="until != null">
            AND created_at &lt;= #{until}
        </if>
        <if test="eventTypes != null and eventTypes.size() &gt; 0">
            AND diff_snapshot IS NOT NULL
            AND jsonb_extract_path_text(diff_snapshot::jsonb, 'eventType') IN
            <foreach collection="eventTypes" item="et" open="(" separator="," close=")">
                #{et}
            </foreach>
        </if>
        <if test="changeSource != null">
            AND change_source = #{changeSource}
        </if>
    </sql>

    <select id="selectPageByCondition" resultType="cn.ac.fage.accessmesh.access.permission.entity.PermissionChangeLog">
        SELECT * FROM permission_change_log
        <include refid="listCondition"/>
        ORDER BY created_at DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByCondition" resultType="long">
        SELECT COUNT(*) FROM permission_change_log
        <include refid="listCondition"/>
    </select>

</mapper>
