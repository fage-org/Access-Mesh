<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ac.fage.accessmesh.access.bootstrap.mapper.TenantBaselineMapper">

    <!-- 专属初始化通道：种子内容由权威 DDL 的 initialize_tenant_baseline 函数维护；
         flushCache 确保函数内写库后同事务后续读取不吃会话缓存 -->
    <select id="initialize" resultType="java.lang.String" useCache="false" flushCache="true">
        SELECT initialize_tenant_baseline(#{tenantId})::text
    </select>
</mapper>
