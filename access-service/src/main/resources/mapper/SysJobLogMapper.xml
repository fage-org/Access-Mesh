<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ac.fage.accessmesh.access.admin.mapper.SysJobLogMapper">

    <select id="paginateJobLogs" resultType="cn.ac.fage.accessmesh.access.admin.entity.SysJobLog">
        SELECT * FROM sys_job_log
        WHERE tenant_id = #{tenantId}
        <if test="jobId != null">
            AND job_id = #{jobId}
        </if>
        ORDER BY created_at DESC
    </select>

</mapper>