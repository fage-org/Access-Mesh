<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.ac.fage.accessmesh.access.admin.mapper.SysLoginLogMapper">

    <!-- XML 分页统一 offset/limit + count 双查询（T-ADMIN-026；id 作 tie-breaker 保证分页稳定；
         日志表无 delete_flag，与既有查询口径一致 -->
    <select id="selectByTenantIdPaged" resultType="cn.ac.fage.accessmesh.access.admin.entity.SysLoginLog">
        SELECT * FROM sys_login_log
        WHERE tenant_id = #{tenantId}
        ORDER BY login_at DESC, id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countByTenantId" resultType="long">
        SELECT COUNT(*) FROM sys_login_log
        WHERE tenant_id = #{tenantId}
    </select>

</mapper>
