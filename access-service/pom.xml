<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ac.fage.accessmesh</groupId>
        <artifactId>accessmesh</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>access-service</artifactId>
    <name>Access Service</name>
    <description>Unified admin + permission management service</description>

    <properties>
        <!-- 单测轨道开关（T-ACCESS-017 双 execution 分层）：true 时 mvn test 跳过
             testcontainers 组 execution，只跑单测（CI 单测 job / 本地快速反馈） -->
        <skipTestcontainers>false</skipTestcontainers>
        <!-- 容器组 fork 数（T-ACCESS-030）：默认 2；-Dit.forkCount=1 串行复跑定性 fork 级抖动的逃生门 -->
        <it.forkCount>2</it.forkCount>
    </properties>

    <dependencies>
        <!-- Internal modules -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>common</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>perm-common</artifactId>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- Spring Cloud -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mybatis-flex</groupId>
            <artifactId>mybatis-flex-codegen</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- Cache -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-boot-starter</artifactId>
            <version>${redisson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Auth -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-jwt</artifactId>
            <version>${sa-token.version}</version>
        </dependency>
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-redis-jackson</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- Tools -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <fork>true</fork>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>com.mybatis-flex</groupId>
                            <artifactId>mybatis-flex-processor</artifactId>
                            <version>${mybatis-flex.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <!-- 禁用 Nacos SpringApplicationRunListener 默认日志：测试不得在构建目录外写日志文件（如 ~/logs/nacos/config.log） -->
                        <nacos.logging.default.config.enabled>false</nacos.logging.default.config.enabled>
                        <!-- Docker 25+ 与 docker-java 3.3.6 兼容（2026-08-22，用户决策 pom 固定）：
                             Testcontainers 1.19.x 携带的 docker-java 默认走 API 1.32，
                             Docker 29 起守护进程最低仅支持 API 1.44，未固定版本时
                             @Testcontainers(disabledWithoutDocker=true) 测试会被静默跳过。 -->
                        <api.version>1.44</api.version>
                    </systemPropertyVariables>
                    <!-- T-ACCESS-004 评审 P1-2（2026-08-14，用户决策 Surefire 纳入）：
                         安全矩阵 IT（SecurityMatrixIT/SyncEndpointAuthIT）必须随默认 mvn test 执行，
                         Surefire 默认规则排除 *IT.java，显式 include 接入。 -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <!-- T-ACCESS-017（2026-08-23，用户决策「两类分开测试」）：默认 execution 排除容器组。
                         MyBatis-Flex 方言挂在全局静态 FlexGlobalConfig.defaultConfig，同 JVM 混跑时
                         先行的 H2 上下文（AccessServiceApplicationTest 等）会把方言置为反引号风格，
                         后续 PG 容器测试的 BaseMapper 语句全部 BadSqlGrammar。两个 execution
                         各自独立 fork 进程（surefire 每个执行目标独立起 JVM），物理隔离串扰；
                         进程内各自保持 fork 复用，时长不受 reuseForks=false 类级分叉拖累。
                         容器组内全部为 PG 上下文、单测组内 H2/Mockito 同类相聚，组内方言一致无串扰。 -->
                    <excludedGroups>testcontainers</excludedGroups>
                    <!-- 双 execution 下 -Dtest 定向只命中其中一个 execution，另一个必须容忍空匹配 -->
                    <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
                </configuration>
                <executions>
                    <execution>
                        <id>testcontainers</id>
                        <phase>test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <!-- 清空继承的 excludedGroups，改为按组纳入容器测试 -->
                            <excludedGroups combine.self="override"/>
                            <groups>testcontainers</groups>
                            <!-- 单测轨道开关：mvn test -DskipTestcontainers=true 跳过本 execution -->
                            <skip>${skipTestcontainers}</skip>
                            <!-- T-ACCESS-030 容器组 fork 级并行：测试类分配到 2 个常驻 fork JVM。
                                 必须用进程级而非 JUnit 线程级——sa-token 的 SaManager 是 JVM 级静态单例
                                 （SaBeanInject 每上下文启动时重注入），线程级类并发下邻类上下文关闭会
                                 把静态 dao 指向已 shutdown 的 Redisson（login 路径 500，2026-09-06 两轮
                                 并发回归实证：FileService/OrgTree/AccessBootstrap 共 43 失败、堆栈
                                 SaTokenDaoRedisJackson.get）；fork=独立 JVM 静态天然隔离（与 T-ACCESS-017
                                 双 execution 分轨同哲学）。ItInfra 启动时以文件锁抢占 1..4 槽位作为
                                 fork 标记（surefire 的 ${surefire.forkNumber} 在 systemPropertyVariables
                                 中插值为空串，不可用——第五轮实证），类库/模板/Redis 索引段按槽位隔离。 -->
                            <forkCount>${it.forkCount}</forkCount>
                            <reuseForks>true</reuseForks>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
