<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cn.ac.fage.accessmesh</groupId>
        <artifactId>perm-sdk</artifactId>
        <version>0.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>perm-common</artifactId>
    <name>Perm Common</name>
    <description>Shared models, exceptions, utilities for permission SDK</description>

    <dependencies>
        <!-- 两个消费 FeignCredentialInterceptor 的 starter 已提供 common；只在此编译引用单源清单，避免向纯 DTO 消费者传递 Web/cache 实现依赖。 -->
        <dependency>
            <groupId>cn.ac.fage.accessmesh</groupId>
            <artifactId>common</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
            <exclusions>
                <exclusion><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-logging</artifactId></exclusion>
            </exclusions>
        </dependency>
        <!-- T-PERM-070 凭证头注入拦截器（FeignCredentialInterceptor）落本模块供
             client/registration（071）两 starter 共用；openfeign 由使用方 starter
             的 spring-cloud-starter-openfeign 提供，这里仅编译期可见 -->
        <dependency>
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- T-ACCESS-100：SDK 真正公共依赖显式化——SLF4J API 编译期可见、由宿主供应
             （任何 Spring Boot starter 都带）；不再经 common 的日志实现件间接获得 -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- T-ACCESS-100 r2：测试域后端=全局 starter-test 携带的 Logback（库模块口径） -->
        <!-- SDK JSON codec includes Java time support in Jackson 3, without a Web runtime dependency. -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-http-converter</artifactId>
        </dependency>
    </dependencies>
</project>
